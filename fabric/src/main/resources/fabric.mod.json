{
  "schemaVersion": 1,
  "id": "${modid}",
  "version": "${version}",
  "name": "${display_name}",
  "description": "${description}",
  "authors": [
    "${authors}"
  ],
  "contact": {
    "homepage": "${homepage}",
    "issues": "${issues}",
    "sources": "${source}"
  },
  "license": "${license}",
  "icon": "assets/tchighwaysigns/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.remake1.tchighwaysigns.fabric.HighwaySignsFabric"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "architectury": ">=${architectury_api_version}",
    "forgeconfigapiport": "*",
    "trafficcraft": [">=${minecraft_version}-1.1.3 <${minecraft_version}-alpha", ">=${minecraft_version}-beta-1.2.0 <${minecraft_version}-rc"]
  }
}
